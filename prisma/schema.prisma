// MessMate - PostgreSQL Schema (Production)
// Precision-safe financial mess accounting system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  MEMBER
  ADMIN
}

enum ExpenseType {
  BAZAR
  SHARED
  INDIVIDUAL
}

enum PaymentSource {
  PERSONAL
  MESS_FUND
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  BANK_TRANSFER
  OTHER
}

enum AllocationMethod {
  EQUAL
  CUSTOM
  PROPORTIONAL
}

enum LedgerEntryType {
  OPENING_BALANCE
  DEPOSIT
  BAZAR_PAYMENT
  MEAL_COST
  SHARED_EXPENSE
  INDIVIDUAL_EXPENSE
  ADJUSTMENT
  MONTHLY_CLOSING
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String?       @unique
  phone        String        @unique
  passwordHash String        @default("")
  role         Role          @default(MEMBER)
  isActive     Boolean       @default(true)
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships  MessMember[]
  auditLogs    AuditLog[]
  createdExpenses Expense[]  @relation("ExpenseCreator")
  createdDeposits  Deposit[]  @relation("DepositCreator")
  createdNotices   Notice[]   @relation("NoticeCreator")

  @@map("users")
}

model Mess {
  id                    String       @id @default(cuid())
  name                  String
  address               String?
  logoUrl               String?
  coverUrl              String?
  contactPhone          String?
  description           String?
  currency              String       @default("BDT")
  currencySymbol        String       @default("৳")
  timezone              String       @default("Asia/Dhaka")
  fractionalMeals       Boolean      @default(true)
  primaryManagerId      String?
  primaryAdminMemberId  String?
  currentManagerMemberId String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  members               MessMember[]
  monthlyPeriods        MonthlyPeriod[]
  expenses              Expense[]
  deposits              Deposit[]
  closings              MonthlyClosing[]
  auditLogs             AuditLog[]
  settings              MessSetting?
  profile               MessProfile?
  categories            ExpenseCategory[]
  managerAssignments   ManagerAssignment[]
  adminPrivilegeLogs   AdminPrivilegeLog[]
  notices               Notice[]
  conversations         Conversation[]
  pushSubscriptions     PushSubscription[]
  notifications         Notification[]
  bazarSchedules        BazarSchedule[]
  fines                 Fine[]
  maintenanceExpenses   MaintenanceExpense[]
  fineFundTransactions  FineFundTransaction[]

  @@map("messes")
}

model MessMember {
  id                    String        @id @default(cuid())
  messId                String
  userId                String
  fullName              String
  phone                 String
  email                 String?
  roomNumber            String?
  bio                   String?
  avatarUrl             String?
  joiningDate           DateTime      @default(now())
  leavingDate           DateTime?
  isActive              Boolean       @default(true)
  isArchived            Boolean       @default(false)
  archivedAt            DateTime?
  isPrimaryAdmin        Boolean       @default(false)
  isAdmin               Boolean       @default(false)
  adminGrantedAt        DateTime?
  adminGrantedById      String?
  isManager             Boolean       @default(false)
  initialOpeningBalance Decimal       @default(0) @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  mess                  Mess          @relation(fields: [messId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  mealEntries           MealEntry[]
  deposits              Deposit[]
  expensesPaid          Expense[]     @relation("ExpensePayer")
  assignedExpenses      Expense[]     @relation("IndividualExpenseTarget")
  sharedAllocations     SharedExpenseAllocation[]
  ledgerEntries         MemberLedgerEntry[]
  closingDetails        MonthlyClosingDetail[]
  managerAssignments   ManagerAssignment[]
  adminLogs             AdminPrivilegeLog[]
  conversations         ConversationParticipant[]
  sentMessages          Message[]     @relation("SentMessages")
  pushSubscriptions     PushSubscription[]
  notifications         Notification[]
  bazarSchedules        BazarSchedule[]
  fines                 Fine[]
  fineFundTransactions  FineFundTransaction[]

  @@unique([messId, userId])
  @@index([messId, isActive, isArchived])
  @@map("mess_members")
}

model ManagerAssignment {
  id           String      @id @default(cuid())
  messId       String
  memberId     String
  assignedById String?
  assignedAt   DateTime    @default(now())
  endedAt      DateTime?
  notes        String?

  mess         Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)
  member       MessMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([messId, assignedAt])
  @@map("manager_assignments")
}

model AdminPrivilegeLog {
  id            String      @id @default(cuid())
  messId        String
  memberId      String
  action        String      // "GRANTED", "REVOKED"
  performedById String?
  performedAt   DateTime    @default(now())
  notes         String?

  mess          Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)
  member        MessMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([messId, performedAt])
  @@map("admin_privilege_logs")
}

model MonthlyPeriod {
  id           String         @id @default(cuid())
  messId       String
  year         Int
  month        Int            // 1-12
  startDate    DateTime
  endDate      DateTime
  isClosed     Boolean        @default(false)
  closedAt     DateTime?
  closedById   String?
  reopenedAt   DateTime?
  reopenedById String?
  reopenReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  mess         Mess           @relation(fields: [messId], references: [id], onDelete: Cascade)
  mealEntries  MealEntry[]
  expenses     Expense[]
  deposits     Deposit[]
  closing      MonthlyClosing?

  @@unique([messId, year, month])
  @@index([messId, isClosed])
  @@map("monthly_periods")
}

model MealEntry {
  id          String         @id @default(cuid())
  messId      String
  periodId    String
  memberId    String
  date        DateTime
  breakfast   Decimal        @default(0) @db.Decimal(4, 2)
  lunch       Decimal        @default(0) @db.Decimal(4, 2)
  dinner      Decimal        @default(0) @db.Decimal(4, 2)
  totalMeals  Decimal        @default(0) @db.Decimal(5, 2)
  notes       String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  member      MessMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  period      MonthlyPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([periodId, date])
  @@index([messId, date])
  @@map("meal_entries")
}

model Expense {
  id               String            @id @default(cuid())
  messId           String
  periodId         String
  date             DateTime
  title            String
  description      String?
  amount           Decimal           @db.Decimal(12, 2)
  expenseType      ExpenseType       @default(BAZAR)
  category         String
  paymentSource    PaymentSource     @default(MESS_FUND)
  payerMemberId    String?
  targetMemberId   String?
  receiptUrl       String?
  allocationMethod AllocationMethod? @default(EQUAL)
  isApproved       Boolean           @default(true)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  mess             Mess              @relation(fields: [messId], references: [id], onDelete: Cascade)
  period           MonthlyPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  payerMember      MessMember?       @relation("ExpensePayer", fields: [payerMemberId], references: [id], onDelete: SetNull)
  targetMember     MessMember?       @relation("IndividualExpenseTarget", fields: [targetMemberId], references: [id], onDelete: SetNull)
  creator          User?             @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  
  sharedAllocations SharedExpenseAllocation[]

  @@index([messId, periodId, expenseType])
  @@index([date])
  @@map("expenses")
}

model SharedExpenseAllocation {
  id              String      @id @default(cuid())
  expenseId       String
  memberId        String
  amount          Decimal     @db.Decimal(12, 2)
  sharePercentage Decimal?    @db.Decimal(5, 2)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  expense         Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member          MessMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
  @@map("shared_expense_allocations")
}

model Deposit {
  id            String        @id @default(cuid())
  messId        String
  periodId      String
  memberId      String
  depositDate   DateTime
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  transactionId String?
  notes         String?
  receiptUrl    String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  mess          Mess          @relation(fields: [messId], references: [id], onDelete: Cascade)
  period        MonthlyPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  member        MessMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  creator       User?         @relation("DepositCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([messId, periodId])
  @@index([memberId])
  @@map("deposits")
}

model ExpenseCategory {
  id        String      @id @default(cuid())
  messId    String
  name      String
  nameBn    String?
  type      ExpenseType @default(BAZAR)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  mess      Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@unique([messId, name, type])
  @@map("expense_categories")
}

model MemberLedgerEntry {
  id          String          @id @default(cuid())
  messId      String
  memberId    String
  periodId    String?
  date        DateTime
  entryType   LedgerEntryType
  description String
  debit       Decimal         @default(0) @db.Decimal(12, 2)
  credit      Decimal         @default(0) @db.Decimal(12, 2)
  balance     Decimal         @db.Decimal(12, 2)
  referenceId String?
  createdAt   DateTime        @default(now())

  member      MessMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, date])
  @@index([messId, periodId])
  @@map("member_ledger_entries")
}

model MonthlyClosing {
  id                     String                 @id @default(cuid())
  messId                 String
  periodId               String                 @unique
  closingDate            DateTime               @default(now())
  closedById             String
  totalMeals             Decimal                @db.Decimal(10, 2)
  totalBazarExpense      Decimal                @db.Decimal(12, 2)
  mealRate               Decimal                @db.Decimal(10, 4)
  totalDeposits          Decimal                @db.Decimal(12, 2)
  totalSharedExpenses    Decimal                @db.Decimal(12, 2)
  totalIndividualExpenses Decimal               @db.Decimal(12, 2)
  totalPersonalPayments  Decimal                @db.Decimal(12, 2)
  totalMessFundPayments  Decimal                @db.Decimal(12, 2)
  totalNetDues           Decimal                @db.Decimal(12, 2)
  totalNetAdvances       Decimal                @db.Decimal(12, 2)
  status                 String                 @default("CLOSED")
  notes                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  mess                   Mess                   @relation(fields: [messId], references: [id], onDelete: Cascade)
  period                 MonthlyPeriod          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  details                MonthlyClosingDetail[]

  @@map("monthly_closings")
}

model MonthlyClosingDetail {
  id                   String         @id @default(cuid())
  closingId            String
  memberId             String
  totalMeals           Decimal        @db.Decimal(8, 2)
  mealRate             Decimal        @db.Decimal(10, 4)
  mealCost             Decimal        @db.Decimal(12, 2)
  sharedExpenseCost    Decimal        @db.Decimal(12, 2)
  individualExpenseCost Decimal       @db.Decimal(12, 2)
  totalCost            Decimal        @db.Decimal(12, 2)
  deposits             Decimal        @db.Decimal(12, 2)
  personalPayments     Decimal        @db.Decimal(12, 2)
  openingBalance       Decimal        @db.Decimal(12, 2)
  closingBalance       Decimal        @db.Decimal(12, 2)
  isAdvance            Boolean
  isDue                Boolean
  createdAt            DateTime       @default(now())

  closing              MonthlyClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)
  member               MessMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([closingId, memberId])
  @@map("monthly_closing_details")
}

model AuditLog {
  id        String   @id @default(cuid())
  messId    String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  reason    String?
  ipAddress String?
  createdAt DateTime @default(now())

  mess      Mess?    @relation(fields: [messId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([messId, createdAt])
  @@index([action, entity])
  @@map("audit_logs")
}

model MessSetting {
  id                      String   @id @default(cuid())
  messId                  String   @unique
  allowFractionalMeals    Boolean  @default(true)
  defaultAllocationMethod String   @default("EQUAL")
  autoCarryForwardBalance Boolean  @default(true)
  lowBalanceThreshold     Decimal  @default(500.0) @db.Decimal(12, 2)
  language                String   @default("en")
  timezone                String   @default("Asia/Dhaka")
  currency                String   @default("BDT")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  mess                    Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@map("mess_settings")
}

model MessProfile {
  id               String    @id @default(cuid())
  messId           String    @unique
  messName         String
  logoUrl          String?
  coverUrl         String?
  fullAddress      String?
  location         String?
  contactPhone     String?
  email            String?
  description      String?
  establishedDate  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mess             Mess      @relation(fields: [messId], references: [id], onDelete: Cascade)

  @@map("mess_profiles")
}

model Notice {
  id            String       @id @default(cuid())
  messId        String
  title         String
  content       String
  category      String       @default("GENERAL") // BAZAR_LIST, MEAL_SCHEDULE, SHOPPING_REQ, EXPENSES, ANNOUNCEMENT, MESS_RULES, MAINTENANCE, EMERGENCY, GENERAL
  isPinned      Boolean      @default(false)
  month         Int?
  year          Int?
  publishedAt   DateTime     @default(now())
  expiresAt     DateTime?
  isArchived    Boolean      @default(false)
  attachmentUrl String?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  mess          Mess         @relation(fields: [messId], references: [id], onDelete: Cascade)
  creator       User?        @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([messId, isArchived, publishedAt])
  @@index([messId, month, year])
  @@map("notices")
}

model Conversation {
  id           String                    @id @default(cuid())
  messId       String
  isGroup      Boolean                   @default(false)
  title        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  mess         Mess                      @relation(fields: [messId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([messId, updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  memberId       String
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member         MessMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([memberId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderMemberId String
  content        String
  attachmentUrl  String?
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessMember   @relation("SentMessages", fields: [senderMemberId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model PushSubscription {
  id        String   @id @default(cuid())
  messId    String
  memberId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mess   Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  member MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([messId, memberId])
  @@map("push_subscriptions")
}

model Notification {
  id        String   @id @default(cuid())
  messId    String
  memberId  String?
  title     String
  titleBn   String?
  body      String
  bodyBn    String?
  type      String   @default("ANNOUNCEMENT")
  url       String   @default("/dashboard")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  mess   Mess        @relation(fields: [messId], references: [id], onDelete: Cascade)
  member MessMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([messId, memberId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model BazarSchedule {
  id          String     @id @default(cuid())
  messId      String
  memberId    String
  startDate   DateTime
  endDate     DateTime
  status      String     @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED
  notes       String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  mess        Mess       @relation(fields: [messId], references: [id], onDelete: Cascade)
  member      MessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([messId, startDate, endDate])
  @@index([memberId])
  @@map("bazar_schedules")
}

model Fine {
  id                   String                @id @default(cuid())
  messId               String
  memberId             String
  amount               Decimal               @db.Decimal(12, 2)
  reason               String
  fineDate             DateTime
  isPaid               Boolean               @default(false)
  paidAt               DateTime?
  paymentMethod        PaymentMethod?        @default(CASH)
  transactionId        String?
  notes                String?
  createdById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  mess                 Mess                  @relation(fields: [messId], references: [id], onDelete: Cascade)
  member               MessMember            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fineFundTransactions FineFundTransaction[]

  @@index([messId, isPaid])
  @@index([memberId])
  @@map("fines")
}

model MaintenanceExpense {
  id                   String                @id @default(cuid())
  messId               String
  title                String
  description          String?
  amount               Decimal               @db.Decimal(12, 2)
  expenseDate          DateTime
  paidFromFineFund     Boolean               @default(true)
  receiptUrl           String?
  category             String                @default("MAINTENANCE")
  createdById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  mess                 Mess                  @relation(fields: [messId], references: [id], onDelete: Cascade)
  fineFundTransactions FineFundTransaction[]

  @@index([messId, expenseDate])
  @@map("maintenance_expenses")
}

model FineFundTransaction {
  id                   String              @id @default(cuid())
  messId               String
  type                 String              // "FINE_COLLECTION" | "MAINTENANCE_EXPENSE"
  amount               Decimal             @db.Decimal(12, 2)
  date                 DateTime
  description          String
  memberId             String?
  fineId               String?
  maintenanceExpenseId String?
  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  mess                 Mess                @relation(fields: [messId], references: [id], onDelete: Cascade)
  member               MessMember?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fine                 Fine?               @relation(fields: [fineId], references: [id], onDelete: SetNull)
  maintenanceExpense   MaintenanceExpense? @relation(fields: [maintenanceExpenseId], references: [id], onDelete: SetNull)

  @@index([messId, type, date])
  @@index([memberId])
  @@map("fine_fund_transactions")
}
